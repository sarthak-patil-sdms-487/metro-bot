PRIMARY_LLM_API_KEY=
PRIMARY_LLM_MODEL=openai/gpt-4o-mini
PRIMARY_LLM_BASE_URL=https://openrouter.ai/api/v1
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=gemini-3.1-flash-lite

# Meta WhatsApp text/chat
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
JWT_SECRET_KEY=change-me

# Meta WhatsApp Calling (reuse text credentials by leaving token/ID blank)
WHATSAPP_CALLING_ENABLED=false
WHATSAPP_CALLING_ACCESS_TOKEN=
WHATSAPP_CALLING_PHONE_NUMBER_ID=
WHATSAPP_CALLING_APP_SECRET=
WHATSAPP_CALLING_API_VERSION=v23.0

# Sarvam real-time STT/TTS
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER_ENGLISH=shreya
SARVAM_TTS_SPEAKER_HINDI=shreya
SARVAM_TTS_SPEAKER_MARATHI=shreya
SARVAM_TTS_PACE=1.0
SARVAM_TTS_TEMPERATURE=0.6
CALL_RECORDINGS_DIR=/app/recordings
# Cost/cache controls (override when provider pricing or FX changes)
QA_CACHE_TTL_HOURS=24
QA_CACHE_FUZZY_THRESHOLD=0.92
LLM_INPUT_USD_PER_MILLION=0.15
LLM_OUTPUT_USD_PER_MILLION=0.60
USD_TO_INR=84.0
SARVAM_STT_INR_PER_HOUR=30.0
SARVAM_TTS_INR_PER_10K_CHARS=30.0
